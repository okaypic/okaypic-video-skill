 "captions": {
  "01": [
   {
    "start": 0.0,
    "end": 6.28,
    "en": "A prank collective. Probably a crypto marketing stunt.",
    "zh": "一个恶作剧团伙。多半是某个加密货币的营销噱头。"
   },
   {
    "start": 6.28,
    "end": 10.12,
    "en": "Goblins. Sure. How much do I buy?",
    "zh": "哥布林？行啊。我该买多少？"
   }
  ],
  "02": [
   {
    "start": 0.0,
    "end": 10.12,
    "en": "Every city has a bottom. Meridian's is further down than most.",
    "zh": "每座城市都有底。子午城的底，比别处更深。"
   }
  ],
  "03": [
   {
    "start": 0.0,
    "end": 4.39,
    "en": "Your Series B is dead, Victor. Everyone knows.",
    "zh": "你的 B 轮已经死了，Victor。谁都知道。"
   },
   {
    "start": 4.99,
    "end": 10.12,
    "en": "I have two months of payroll. I'm fine.",
    "zh": "我还有两个月的工资。我没事。"
   }
  ],
  "04": [
   {
    "start": 0.0,
    "end": 5.39,
    "en": "GoblinCoin. Tomorrow, nine a.m. It moves.",
    "zh": "哥布林币。明天早上九点，它会动。"
   },
   {
    "start": 5.39,
    "end": 6.97,
    "en": "A meme coin?",
    "zh": "一个 meme 币？"
   },
   {
    "start": 6.97,
    "end": 10.12,
    "en": "Don't ask me how I know.",
    "zh": "别问我怎么知道的。"
   }
  ],
  "05": [
   {
    "start": 2.0,
    "end": 5.66,
    "en": "Nobody suspects a joke. That's the point.",
    "zh": "没人会怀疑一个笑话。这就是关键。"
   },
   {
    "start": 5.66,
    "end": 10.12,
    "en": "Ten x. Two million. By Friday I'm a founder again.",
    "zh": "十倍杠杆。两百万。周五之前我又是创始人了。"
   }
  ],
  "06": [
   {
    "start": 5.19,
    "end": 7.49,
    "en": "Good evening, Mr. Hale.",
    "zh": "晚上好，Hale 先生。"
   },
